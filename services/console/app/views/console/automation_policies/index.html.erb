<% content_for :title, "Automations · Centaur Console" %>

<%= render "console/page_header",
           title: "Repository Automations",
           subtitle: "Policy-gated GitHub and Linear work that continues on one durable PR or issue workstream.",
           icon: "workflow",
           actions: link_to("New policy", new_console_automation_policy_path, class: "btn-primary") %>

<section class="space-y-6">
  <div class="console-panel overflow-hidden">
    <table class="console-table">
      <thead class="console-table-head">
        <tr>
          <th class="console-th">Policy</th>
          <th class="console-th">Scope</th>
          <th class="console-th">Behavior</th>
          <th class="console-th">Mode</th>
          <th class="console-th"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-700">
        <% if @policies.empty? %>
          <tr>
            <td colspan="5" class="px-5 py-10 text-center text-zinc-600">
              No automation policies yet. Start in observe mode to see what would run.
            </td>
          </tr>
        <% end %>
        <% @policies.each do |policy| %>
          <tr class="console-row-hover align-top">
            <td class="console-td">
              <div class="font-medium text-zinc-100"><%= policy.name %></div>
              <div class="mt-1 text-xs text-zinc-600"><%= policy.provider.capitalize %> · created by <%= policy.created_by.email %></div>
            </td>
            <td class="console-td font-mono text-xs text-zinc-300"><%= policy.scope_label %></td>
            <td class="console-td text-xs text-zinc-400"><%= policy.automation_summary %></td>
            <td class="console-td text-xs">
              <% if !policy.enabled? %>
                <span class="rounded border border-zinc-700 px-2 py-1 text-zinc-500">disabled</span>
              <% elsif policy.mode == "act" %>
                <span class="rounded border border-amber-400/40 bg-amber-400/10 px-2 py-1 text-amber-200">act</span>
              <% else %>
                <span class="rounded border border-sky-400/40 bg-sky-400/10 px-2 py-1 text-sky-200">observe</span>
              <% end %>
            </td>
            <td class="console-td">
              <div class="flex justify-end gap-2">
                <%= link_to "Edit", edit_console_automation_policy_path(policy.oid), class: "btn-secondary py-1.5" %>
                <%= button_to "Delete", console_automation_policy_path(policy.oid), method: :delete,
                              class: "btn-secondary py-1.5 text-red-300",
                              data: { turbo_confirm: "Delete #{policy.name}?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div>
    <h2 class="mb-3 text-sm font-semibold text-zinc-200">Recent workstreams</h2>
    <div class="console-panel overflow-hidden">
      <table class="console-table">
        <thead class="console-table-head">
          <tr>
            <th class="console-th">Subject</th>
            <th class="console-th">Session</th>
            <th class="console-th">Policy</th>
            <th class="console-th">Events</th>
            <th class="console-th">Last event</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-700">
          <% if @workstreams.empty? %>
            <tr>
              <td colspan="5" class="px-5 py-8 text-center text-zinc-600">No inbound automation events yet.</td>
            </tr>
          <% end %>
          <% @workstreams.each do |workstream| %>
            <tr class="console-row-hover">
              <td class="console-td font-mono text-xs text-zinc-300"><%= workstream.subject_key %></td>
              <td class="console-td text-xs">
                <%= link_to workstream.session_key,
                            console_threads_path(thread: workstream.session_key),
                            class: "console-link font-mono" %>
              </td>
              <td class="console-td text-xs text-zinc-400"><%= workstream.automation_policy&.name || "no matching policy" %></td>
              <td class="console-td text-xs text-zinc-400"><%= workstream.event_count %></td>
              <td class="console-td text-xs text-zinc-500"><%= local_time(workstream.last_event_at, relative: true, format: :compact) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
